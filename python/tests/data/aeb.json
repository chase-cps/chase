{
  "contracts": [
    {
      "name": "p",
      "inputs": {},
      "outputs": {
        "t_p": "real",
        "T_p": "real",
        "d_p": "real"
      },
      "assumptions": [],
      "guarantees": [
        "!true | (d_p <= T_p & T_p - d_p <= 0.05 & t_p <= d_p)"
      ]
    },
    {
      "name": "a",
      "inputs": {
        "t_p": "real",
        "T_p": "real",
        "d_p": "real"
      },
      "outputs": {
        "t_a": "real",
        "T_a": "real",
        "d_a": "real"
      },
      "assumptions": [
        "t_p <= d_p"
      ],
      "guarantees": [
        "!(t_p <= d_p) | (t_a = t_p & d_a >= T_p & d_a <= T_p & d_a <= T_a & T_a - d_a <= 3 & t_a <= d_a)"
      ]
    },
    {
      "name": "b",
      "inputs": {
        "t_a": "real",
        "T_a": "real",
        "d_a": "real"
      },
      "outputs": {
        "t_b": "real",
        "T_b": "real",
        "d_b": "real"
      },
      "assumptions": [
        "t_a <= d_a"
      ],
      "guarantees": [
        "!(t_a <= d_a) | (t_b = t_a & d_b >= T_a & d_b <= T_a & d_b <= T_b & T_b - d_b <= 0 & t_b <= d_b)"
      ]
    },
    {
      "name": "c",
      "inputs": {},
      "outputs": {
        "t_c": "real",
        "T_c": "real",
        "d_c": "real"
      },
      "assumptions": [],
      "guarantees": [
        "!true | (d_c <= T_c & T_c - d_c <= 0 & t_c <= d_c)"
      ]
    },
    {
      "name": "d",
      "inputs": {
        "t_c": "real",
        "T_c": "real",
        "d_c": "real"
      },
      "outputs": {
        "t_d": "real",
        "T_d": "real",
        "d_d": "real"
      },
      "assumptions": [
        "t_c <= d_c"
      ],
      "guarantees": [
        "!(t_c <= d_c) | (t_d = t_c & d_d >= T_c & d_d <= T_c & d_d <= T_d & T_d - d_d <= 2 & t_d <= d_d)"
      ]
    },
    {
      "name": "f",
      "inputs": {
        "t_e": "real",
        "T_e": "real",
        "d_e": "real"
      },
      "outputs": {
        "t_f": "real",
        "T_f": "real",
        "d_f": "real"
      },
      "assumptions": [
        "t_e <= d_e"
      ],
      "guarantees": [
        "!(t_e <= d_e) | (t_f = t_e & d_f >= d_e & d_f >= T_e & (d_f <= d_e | d_f <= T_e) & d_f <= T_f & T_f - d_f <= 0 & t_f <= d_f)"
      ]
    },
    {
      "name": "e",
      "inputs": {
        "t_d": "real",
        "T_d": "real",
        "d_d": "real"
      },
      "outputs": {
        "t_e": "real",
        "T_e": "real",
        "d_e": "real"
      },
      "assumptions": [
        "t_d <= d_d"
      ],
      "guarantees": [
        "!(t_d <= d_d) | (t_e - t_d = kappa & T_d <= T_e & T_e <= T_d + 9 & t_e <= d_e)"
      ],
      "constants": {
        "kappa": 10
      }
    },
    {
      "name": "SysB",
      "inputs": {},
      "outputs": {
        "t_p": "real",
        "t_b": "real",
        "d_p": "real",
        "d_b": "real"
      },
      "assumptions": [
        "t_p <= d_p",
        "d_p - t_p <= 1"
      ],
      "guarantees": [
        "!(t_p <= d_p & d_p - t_p <= 1) | d_b - t_b <= lam_b"
      ],
      "constants": {
        "lam_b": 4
      }
    },
    {
      "name": "DelayF",
      "inputs": {},
      "outputs": {
        "t_c": "real",
        "t_e": "real",
        "t_f": "real",
        "d_c": "real",
        "d_e": "real",
        "d_f": "real"
      },
      "assumptions": [
        "t_c = d_c",
        "t_e = d_e"
      ],
      "guarantees": [
        "!(t_c = d_c & t_e = d_e) | d_f - t_f <= y_f"
      ],
      "constants": {
        "y_f": 0.95
      }
    }
  ]
}